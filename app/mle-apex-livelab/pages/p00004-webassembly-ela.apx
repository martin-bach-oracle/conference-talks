page 4 (
    name: WebAssembly ELA
    alias: WEBASSEMBLY-ELA
    title: WebAssembly ELA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .ela-hero {
                padding: clamp(1rem, 3vw, 2.5rem);
                color: #fff;
            }
            .ela-hero__eyebrow {
                color: #b8d9d8;
                font-size: .8rem;
                font-weight: 700;
                letter-spacing: .12em;
                text-transform: uppercase;
            }
            .ela-hero h2 {
                color: #fff;
                font-size: clamp(1.75rem, 3.6vw, 2.75rem);
                line-height: 1.15;
                margin: .75rem 0 1rem;
            }
            .ela-hero p {
                color: #fff;
                font-size: 1rem;
                line-height: 1.6;
                max-width: 70rem;
            }
            .ela-hero__note {
                border-left: 3px solid #f47c6c;
                margin-bottom: 0;
                padding-left: 1rem;
            }
            #ela-comparison {
                max-width: 70rem;
                margin-inline: auto;
            }
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ela-images (
        name: Image comparison
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.id as photo_id,
                       image_type.image_kind,
                       case image_type.image_kind
                           when 1 then 'Original JPEG'
                           else 'ELA difference'
                       end as image_title,
                       case image_type.image_kind
                           when 1 then p.file_blob
                           else e.ela_image
                       end as image_blob,
                       case image_type.image_kind
                           when 1 then 'image/jpeg'
                           else 'image/png'
                       end as image_mime
                  from mle_data p
                  join mle_data_ela e on e.mle_data_id = p.id
                  cross join (select 1 as image_kind from dual
                              union all
                              select 2 from dual) image_type
                 where p.id = :P4_PHOTO_ID
                   and e.status = 'READY'
                   and p.file_blob is not null
                   and e.ela_image is not null
                 order by image_type.image_kind
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ela-comparison
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_PHOTO_ID
        }
        componentAppearance {
            layout: grid
            gridColumns: 2
        }
        card {
            primaryKeyColumn1: PHOTO_ID
            primaryKeyColumn2: IMAGE_KIND
        }
        title {
            column: IMAGE_TITLE
        }
        media {
            source: blobColumn
            blobColumn: IMAGE_BLOB
            position: first
            appearance: widescreen
            sizing: fit
            imageDescription: &IMAGE_TITLE.
        }
        blobAttributes {
            mimeTypeColumn: IMAGE_MIME
        }
    )

    region ela-status (
        name: ELA status
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status mle_data_ela.status%type;
                    l_mime mle_data.file_mime%type;
                begin
                    if :P4_PHOTO_ID is null then
                        sys.htp.p('<p>Select a photo on the Photo Metadata or WebAssembly page first, then open its details before visiting this page.</p>');
                        return;
                    end if;

                    begin
                        select lower(p.file_mime), e.status
                          into l_mime, l_status
                          from mle_data p left join mle_data_ela e on e.mle_data_id = p.id
                         where p.id = :P4_PHOTO_ID;
                    exception
                        when no_data_found then
                            sys.htp.p('<p>The selected photo is no longer available. Select another photo and open its details.</p>');
                            return;
                    end;

                    if l_mime is null or l_mime not in ('image/jpeg', 'image/jpg') then
                        sys.htp.p('<p>ELA is available for JPEG photos only.</p>');
                    elsif l_status = 'PENDING' then
                        sys.htp.p('<p>ELA processing for this photo is pending. Refresh this page later.</p>');
                    elsif l_status = 'FAILED' then
                        sys.htp.p('<p>ELA processing failed for this photo. Check the background process for details.</p>');
                    elsif l_status is null then
                        sys.htp.p('<p>No ELA result is available for this photo. Existing photos are not processed automatically.</p>');
                    end if;
                end;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region ela-info (
        name: Error Level Analysis
        type: staticContent
        source {
            htmlCode:
                ```html
                <section class="ela-hero" aria-labelledby="ela-hero-title">
                  <div class="ela-hero__eyebrow">Oracle APEX · MLE · WebAssembly</div>
                  <h2 id="ela-hero-title">See how JPEG compression changes an image</h2>
                  <p>Error Level Analysis (ELA) is a visual exploration of image compression. After a JPEG is uploaded, Photon runs in the background as WebAssembly inside the database, recompresses it and compares it pixel by pixel with the original. This page shows the selected photo and its stored difference image.</p>
                  <p>The image is recompressed at JPEG quality 90, and pixel differences are amplified 10 times. Only new JPEG uploads are analysed; processing large images may take time.</p>
                  <p class="ela-hero__note"><strong>How to read it:</strong> Bright areas show larger compression differences. They are not proof that an image was manipulated or generated by AI; edges, texture and previous compression can also affect the result. Black pixels mean the corresponding pixels changed little or not at all when the image was recompressed under the chosen settings.</p>
                </section>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P4_PHOTO_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    process select-session-photo (
        name: Use the selected photo
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P4_PHOTO_ID := :P2_ID;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

)
