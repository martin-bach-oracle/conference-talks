page 4 (
    name: WebAssembly ELA
    alias: WEBASSEMBLY-ELA
    title: WebAssembly ELA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .ela-hero {
                padding: clamp(1rem, 3vw, 2.5rem);
                color: #fff;
            }
            .ela-hero__eyebrow {
                color: #b8d9d8;
                font-size: .8rem;
                font-weight: 700;
                letter-spacing: .12em;
                text-transform: uppercase;
            }
            .ela-hero h2 {
                color: #fff;
                font-size: clamp(1.75rem, 3vw, 2.75rem);
                line-height: 1.15;
                margin: .75rem 0 1rem;
            }
            .ela-hero p {
                color: #fff;
                font-size: 1rem;
                line-height: 1.6;
                max-width: 70rem;
            }
            .ela-hero__note {
                border-left: 3px solid #f47c6c;
                margin-bottom: 0;
                padding-left: 1rem;
            }
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ela-images (
        name: ELA
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.id,
                       p.created_by as user_name,
                       p.post_comment as comment_text,
                       photo_ela(p.file_blob) as ela_image,
                       'image/png' as ela_mime,
                       apex_util.get_since(p.created) as post_date
                  from mle_data p
                 where lower(p.file_mime) in ('image/jpeg', 'image/jpg')
                   and p.file_blob is not null
                 order by p.created desc
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            column: USER_NAME
        }
        subtitle {
            column: POST_DATE
        }
        body {
            column: COMMENT_TEXT
        }
        media {
            source: blobColumn
            blobColumn: ELA_IMAGE
            position: first
            appearance: widescreen
            imageDescription: ELA image
        }
        blobAttributes {
            mimeTypeColumn: ELA_MIME
        }
        performance {
            lazyLoading: true
        }
    )

    region ela-info (
        name: Error Level Analysis
        type: staticContent
        source {
            htmlCode:
                ```html
                <section class="ela-hero" aria-labelledby="ela-hero-title">
                  <div class="ela-hero__eyebrow">Oracle APEX · MLE · WebAssembly</div>
                  <h2 id="ela-hero-title">See how JPEG compression changes an image</h2>
                  <p>Error Level Analysis (ELA) is a visual exploration of image compression. Photon, running as WebAssembly inside the database, recompresses each uploaded JPEG and compares it pixel by pixel with the original. The cards below show the original thumbnails and the resulting difference images.</p>
                  <p>The image is recompressed at JPEG quality 90, and pixel differences are amplified 10 times. Only JPEG images are analysed; processing large images may take time.</p>
                  <p class="ela-hero__note"><strong>How to read it:</strong> Bright areas show larger compression differences. They are not proof that an image was manipulated or generated by AI; edges, texture and previous compression can also affect the result.</p>
                </section>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    region thumbnails (
        name: Timeline
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.id,
                       p.created_by as user_name,
                       p.post_comment as comment_text,
                       p.thumbnail,
                       'image/png' as thumbnail_mime,
                       'Original: ' || coalesce(photo_dimensions(p.file_blob), '–') ||
                       ' / ' || coalesce(to_char(dbms_lob.getlength(p.file_blob)), '–') || ' Bytes' ||
                       ' | Thumbnail: ' || coalesce(photo_dimensions(p.thumbnail), '–') ||
                       ' / ' || coalesce(to_char(dbms_lob.getlength(p.thumbnail)), '–') || ' Bytes' as image_info,
                       apex_util.get_since(p.created) as post_date
                  from mle_data p
                 order by p.created desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
            cssClasses: t-Chat
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            column: USER_NAME
        }
        subtitle {
            column: POST_DATE
        }
        body {
            column: COMMENT_TEXT
        }
        secondaryBody {
            column: IMAGE_INFO
        }
        iconAndBadge {
            iconSource: initials
            iconColumn: USER_NAME
        }
        media {
            source: blobColumn
            blobColumn: THUMBNAIL
            position: first
            appearance: widescreen
            sizing: cover
            cssClasses: selectDisable
            imageDescription: &COMMENT_TEXT.
        }
        blobAttributes {
            mimeTypeColumn: THUMBNAIL_MIME
        }
        performance {
            lazyLoading: true
        }

        action details (
            type: fullCard
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 2
                    items: {
                        P2_ID: &ID.
                    }
                }
            }
        )

    )

)

