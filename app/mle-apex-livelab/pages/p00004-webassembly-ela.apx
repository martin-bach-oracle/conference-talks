page 4 (
    name: WebAssembly ELA
    alias: WEBASSEMBLY-ELA
    title: WebAssembly ELA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .ela-hero {
                padding: clamp(1rem, 3vw, 2.5rem);
                color: #fff;
            }
            .ela-hero__eyebrow {
                color: #b8d9d8;
                font-size: .8rem;
                font-weight: 700;
                letter-spacing: .12em;
                text-transform: uppercase;
            }
            .ela-hero h2 {
                color: #fff;
                font-size: clamp(1.75rem, 3vw, 2.75rem);
                line-height: 1.15;
                margin: .75rem 0 1rem;
            }
            .ela-hero p {
                color: #fff;
                font-size: 1rem;
                line-height: 1.6;
                max-width: 70rem;
            }
            .ela-hero__note {
                border-left: 3px solid #f47c6c;
                margin-bottom: 0;
                padding-left: 1rem;
            }
            #P4_ORIGINAL_IMAGE img, #P4_ELA_IMAGE img {
                border-radius: 12px;
                height: auto;
                max-width: 100%;
            }
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ela-images (
        name: Image comparison
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_PHOTO_ID
        }
    )

    region ela-status (
        name: ELA status
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                    l_pending number;
                    l_failed number;
                begin
                    select count(case when status = 'PENDING' then 1 end),
                           count(case when status = 'FAILED' then 1 end)
                      into l_pending, l_failed from mle_data_ela;
                    sys.htp.p('<p>No completed ELA images are available. Pending: ' || l_pending || '; failed: ' || l_failed || '. New JPEG uploads are processed in the background. Check the background process if an image remains pending.</p>');
                end;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        serverSideCondition {
            type: itemIsNull
            item: P4_PHOTO_ID
        }
    )

    region ela-info (
        name: Error Level Analysis
        type: staticContent
        source {
            htmlCode:
                ```html
                <section class="ela-hero" aria-labelledby="ela-hero-title">
                  <div class="ela-hero__eyebrow">Oracle APEX · MLE · WebAssembly</div>
                  <h2 id="ela-hero-title">See how JPEG compression changes an image</h2>
                  <p>Error Level Analysis (ELA) is a visual exploration of image compression. After a JPEG is uploaded, Photon runs in the background as WebAssembly inside the database, recompresses it and compares it pixel by pixel with the original. This page selects one completed result at random and shows the original and the stored difference image.</p>
                  <p>The image is recompressed at JPEG quality 90, and pixel differences are amplified 10 times. Only new JPEG uploads are analysed; processing large images may take time.</p>
                  <p>black pixels mean the corresponding pixels changed little or not at all when the image was recompressed under the chosen settings.</p>
                  <p class="ela-hero__note"><strong>How to read it:</strong> Bright areas show larger compression differences. They are not proof that an image was manipulated or generated by AI; edges, texture and previous compression can also affect the result.</p>
                </section>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P4_PHOTO_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P4_ORIGINAL_IMAGE (
        type: displayImage
        label {
            label: Original JPEG
            alignment: left
        }
        settings {
            basedOn: blobColSql
            sqlQuery: select file_blob from mle_data where id = :P4_PHOTO_ID
        }
        layout {
            sequence: 10
            region: @ela-images
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P4_ELA_IMAGE (
        type: displayImage
        label {
            label: ELA difference
            alignment: left
        }
        settings {
            basedOn: blobColSql
            sqlQuery: select ela_image from mle_data_ela where mle_data_id = :P4_PHOTO_ID and status = 'READY'
        }
        layout {
            sequence: 20
            region: @ela-images
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    process select-random-ela (
        name: Select a completed ELA image
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                begin
                    select mle_data_id into :P4_PHOTO_ID
                      from (select e.mle_data_id from mle_data_ela e
                             join mle_data p on p.id = e.mle_data_id
                            where e.status = 'READY' and e.ela_image is not null
                              and p.file_blob is not null
                            order by dbms_random.value)
                     where rownum = 1;
                exception
                    when no_data_found then :P4_PHOTO_ID := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

)
