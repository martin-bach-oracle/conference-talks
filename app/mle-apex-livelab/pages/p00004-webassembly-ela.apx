page 4 (
    name: WebAssembly ELA
    alias: WEBASSEMBLY-ELA
    title: WebAssembly ELA
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .ela-hero {
                padding: clamp(1rem, 3vw, 2.5rem);
                color: #fff;
            }
            .ela-hero__eyebrow {
                color: #b8d9d8;
                font-size: .8rem;
                font-weight: 700;
                letter-spacing: .12em;
                text-transform: uppercase;
            }
            .ela-hero h2 {
                color: #fff;
                font-size: clamp(1.75rem, 3.6vw, 2.75rem);
                line-height: 1.15;
                margin: .75rem 0 1rem;
            }
            .ela-hero p {
                color: #fff;
                font-size: 1rem;
                line-height: 1.6;
                max-width: 70rem;
            }
            .ela-hero__note {
                border-left: 3px solid #f47c6c;
                margin-bottom: 0;
                padding-left: 1rem;
            }
            #ela-comparison {
                max-width: 70rem;
                margin-inline: auto;
            }
            #ela-ai-explanation {
                max-width: 70rem;
                margin-inline: auto;
            }
            #P4_ELA_SUMMARY_CONTAINER .t-Form-labelContainer,
            #P4_ELA_EXPLANATION_CONTAINER .t-Form-labelContainer {
                display: none;
            }
            #P4_ELA_SUMMARY_CONTAINER .display_only,
            #P4_ELA_EXPLANATION_CONTAINER .display_only {
                color: var(--slide-text);
                display: block;
                font-size: 1rem;
                height: auto;
                line-height: 1.6;
                max-height: none;
                overflow: visible;
                white-space: pre-wrap;
            }
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ela-images (
        name: Image comparison
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.id as photo_id,
                       image_type.image_kind,
                       case image_type.image_kind
                           when 1 then 'Original JPEG'
                           else 'ELA difference'
                       end as image_title,
                       case image_type.image_kind
                           when 1 then p.file_blob
                           else e.ela_image
                       end as image_blob,
                       case image_type.image_kind
                           when 1 then 'image/jpeg'
                           else case
                               when dbms_lob.substr(e.ela_image, 3, 1) = hextoraw('FFD8FF') then 'image/jpeg'
                               when dbms_lob.substr(e.ela_image, 8, 1) = hextoraw('89504E470D0A1A0A') then 'image/png'
                               else 'application/octet-stream'
                           end
                       end as image_mime
                  from mle_data p
                  join mle_data_ela e on e.mle_data_id = p.id
                  cross join (select 1 as image_kind from dual
                              union all
                              select 2 from dual) image_type
                 where p.id = :P4_PHOTO_ID
                   and e.status = 'READY'
                   and p.file_blob is not null
                   and e.ela_image is not null
                 order by image_type.image_kind
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ela-comparison
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_PHOTO_ID
        }
        componentAppearance {
            layout: grid
            gridColumns: 2
        }
        card {
            primaryKeyColumn1: PHOTO_ID
            primaryKeyColumn2: IMAGE_KIND
        }
        title {
            column: IMAGE_TITLE
        }
        media {
            source: blobColumn
            blobColumn: IMAGE_BLOB
            position: first
            appearance: widescreen
            sizing: fit
            imageDescription: &IMAGE_TITLE.
        }
        blobAttributes {
            mimeTypeColumn: IMAGE_MIME
        }
    )

    region ela-status (
        name: ELA status
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status mle_data_ela.status%type;
                    l_mime mle_data.file_mime%type;
                begin
                    if :P4_PHOTO_ID is null then
                        sys.htp.p('<p>Select a photo on the Photo Metadata or WebAssembly page first, then open its details before visiting this page.</p>');
                        return;
                    end if;

                    begin
                        select lower(p.file_mime), e.status
                          into l_mime, l_status
                          from mle_data p left join mle_data_ela e on e.mle_data_id = p.id
                         where p.id = :P4_PHOTO_ID;
                    exception
                        when no_data_found then
                            sys.htp.p('<p>The selected photo is no longer available. Select another photo and open its details.</p>');
                            return;
                    end;

                    if l_mime is null or l_mime not in ('image/jpeg', 'image/jpg') then
                        sys.htp.p('<p>ELA is available for JPEG photos only.</p>');
                    elsif l_status = 'PENDING' then
                        sys.htp.p('<p>ELA processing for this photo is pending. Refresh this page later.</p>');
                    elsif l_status = 'FAILED' then
                        sys.htp.p('<p>ELA processing failed for this photo. Check the background process for details.</p>');
                    elsif l_status is null then
                        sys.htp.p('<p>No ELA result is available for this photo. Existing photos are not processed automatically.</p>');
                    end if;
                end;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region ela-info (
        name: Error Level Analysis
        type: staticContent
        source {
            htmlCode:
                ```html
                <section class="ela-hero" aria-labelledby="ela-hero-title">
                  <div class="ela-hero__eyebrow">Oracle APEX · MLE · WebAssembly</div>
                  <h2 id="ela-hero-title">See how JPEG compression changes an image</h2>
                  <p>Error Level Analysis (ELA) is a visual exploration of image compression. After a JPEG is uploaded, Photon runs in the background as WebAssembly inside the database, recompresses it and compares it pixel by pixel with the original. This page shows the selected photo and its stored difference image.</p>
                  <p>The image is recompressed at JPEG quality 90, and pixel differences are amplified 10 times. New ELA images are stored as JPEG at quality 95; this additional compression can alter subtle differences. Only new JPEG uploads are analysed; processing large images may take time.</p>
                  <p class="ela-hero__note"><strong>How to read it:</strong> Bright areas show larger compression differences. They are not proof that an image was manipulated or generated by AI; edges, texture and previous compression can also affect the result. Black pixels mean the corresponding pixels changed little or not at all when the image was recompressed under the chosen settings.</p>
                </section>
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 8
        }
    )

    region ela-ai-explanation (
        name: ELA summary
        type: staticContent
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ela-ai-explanation
        }
    )

    region ela-detail (
        name: Detailed ELA observation
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P4_PHOTO_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P4_ELA_SUMMARY (
        type: displayOnly
        label {
            label: ELA summary
            alignment: left
        }
        settings {
            format: plainText
            basedOn: value
            showLineBreaks: true
        }
        layout {
            sequence: 10
            region: @ela-ai-explanation
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P4_ELA_EXPLANATION (
        type: displayOnly
        label {
            label: ELA observation
            alignment: left
        }
        settings {
            format: plainText
            basedOn: value
            showLineBreaks: true
        }
        layout {
            sequence: 10
            region: @ela-detail
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction explain-ela (
        name: Explain ELA with AI
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action show-progress (
            name: Show analysis progress
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.item("P4_ELA_SUMMARY").setValue("Preparing ELA summary…");
                    apex.item("P4_ELA_EXPLANATION").setValue("Preparing detailed observation…");
                    ```
            }
            execution {
                sequence: 10
            }
        )

        action generate-explanation (
            name: Generate AI explanation
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
            declare
l_photo blob;
l_ela blob;
l_ela_preview blob;
l_ela_attachment blob;
l_ela_mime varchar2(30);
l_response clob;
l_attachments apex_ai.t_attachments := apex_ai.t_attachments();

procedure free_preview(p_blob in out nocopy blob) is
begin
    if p_blob is not null and dbms_lob.istemporary(p_blob) = 1 then
        dbms_lob.freetemporary(p_blob);
    end if;
end;
            begin
begin
    select p.file_blob, e.ela_image
      into l_photo, l_ela
      from mle_data p join mle_data_ela e on e.mle_data_id = p.id
     where p.id = :P4_PHOTO_ID
       and e.status = 'READY'
       and p.file_blob is not null
       and e.ela_image is not null;
exception
    when no_data_found then
        :P4_ELA_SUMMARY := 'A photo and completed ELA result are required.';
        :P4_ELA_EXPLANATION := 'The photo or ELA result is not available.';
        return;
end;

if dbms_lob.getlength(l_photo) >= 12582912 then
    :P4_ELA_SUMMARY := 'The original photo exceeds the AI attachment budget.';
    :P4_ELA_EXPLANATION := 'Upload a smaller JPEG to request an AI observation.';
    return;
end if;
if dbms_lob.substr(l_ela, 3, 1) = hextoraw('FFD8FF') then
    l_ela_mime := 'image/jpeg';
elsif dbms_lob.substr(l_ela, 8, 1) = hextoraw('89504E470D0A1A0A') then
    l_ela_mime := 'image/png';
else raise_application_error(-20001, 'Unsupported ELA format'); end if;
if dbms_lob.getlength(l_photo) + dbms_lob.getlength(l_ela) <= 12582912 then
    l_ela_attachment := l_ela;
else
    l_ela_preview := photo_ai_preview(l_ela);
    l_ela_attachment := l_ela_preview;
    l_ela_mime := 'image/png';
end if;
if l_ela_attachment is null or dbms_lob.getlength(l_photo) + dbms_lob.getlength(l_ela_attachment) > 12582912 then
    free_preview(l_ela_preview);
    :P4_ELA_SUMMARY := 'The photo and ELA preview exceed the AI attachment budget.';
    :P4_ELA_EXPLANATION := 'Upload a smaller JPEG to request an AI observation.';
    return;
end if;

l_attachments.extend(2);
l_attachments(1).mime_type := 'image/jpeg';
l_attachments(1).content_blob := l_photo;
l_attachments(1).file_name := 'original.jpg';
l_attachments(1).detail_level := apex_ai.c_detail_level_high;
l_attachments(2).mime_type := l_ela_mime;
l_attachments(2).content_blob := l_ela_attachment;
l_attachments(2).file_name := case l_ela_mime when 'image/jpeg' then 'ela.jpg' else 'ela.png' end;
l_attachments(2).detail_level := apex_ai.c_detail_level_high;

l_response := apex_ai.generate(
    p_service_static_id => 'google-gemini',
    p_system_prompt => 'Describe ELA patterns. Do not judge authenticity or AI generation. Return JSON only.',
    p_prompt => q'~The first image is the original JPEG; the second is its ELA image: differences after JPEG quality-90 recompression, amplified by 10. JPEG compression or resizing may alter details; image dimensions may differ.

Return JSON strings "summary" (one or two sentences with a next step) and "detail" (three or four sentences on visible patterns and brightness).

Identify regions unlike nearby textures and suggest comparison with the original. If none are visible or the image is unclear, say so. Do not invent details or infer a cause.~',
    p_temperature => 0.2,
    p_attachments => l_attachments
);
select json_value(l_response, '$.summary' returning varchar2(4000) null on error),
       json_value(l_response, '$.detail' returning varchar2(4000) null on error)
  into :P4_ELA_SUMMARY, :P4_ELA_EXPLANATION
  from dual;
if :P4_ELA_SUMMARY is null or :P4_ELA_EXPLANATION is null then
    raise_application_error(-20001, 'Missing AI summary or detail');
end if;
free_preview(l_ela_preview);
            exception
when others then
    apex_debug.error('ELA AI explanation failed: %s', sqlerrm);
    free_preview(l_ela_preview);
    :P4_ELA_SUMMARY := 'ELA summary is currently unavailable.';
    :P4_ELA_EXPLANATION := 'ELA observation is currently unavailable. Check the application debug log for details.';
            end;
                    ```
                itemsToSubmit: P4_PHOTO_ID
                itemsToReturn: [
                    P4_ELA_SUMMARY
                    P4_ELA_EXPLANATION
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )
    )

    process select-session-photo (
        name: Use the selected photo
        type: executeCode
        source {
            language: plsql
            plsqlCode: :P4_PHOTO_ID := :P2_ID;
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

)
