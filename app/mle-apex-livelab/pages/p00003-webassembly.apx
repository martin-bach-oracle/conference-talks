page 3 (
    name: WebAssembly
    alias: WEBASSEMBLY
    title: WebAssembly
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .thumbnail-hero {
                padding: clamp(1rem, 3vw, 2.5rem);
                color: #fff;
            }
            .thumbnail-hero__eyebrow {
                color: #b8d9d8;
                font-size: .8rem;
                font-weight: 700;
                letter-spacing: .12em;
                text-transform: uppercase;
            }
            .thumbnail-hero h2 {
                color: #fff;
                font-size: clamp(1.75rem, 3.6vw, 2.75rem);
                line-height: 1.15;
                margin: .75rem 0 1rem;
            }
            .thumbnail-hero p {
                color: #fff;
                font-size: 1rem;
                line-height: 1.6;
                max-width: 70rem;
            }
            .thumbnail-hero__note {
                border-left: 3px solid #f47c6c;
                margin-bottom: 0;
                padding-left: 1rem;
            }
            .thumbnail-info {
                color: var(--slide-coral);
            }
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region thumbnail-intro (
        name: Thumbnail generation
        type: staticContent
        source {
            htmlCode:
                ```html
                <section class="thumbnail-hero" aria-labelledby="thumbnail-hero-title">
                  <div class="thumbnail-hero__eyebrow">Oracle APEX · MLE · WebAssembly</div>
                  <h2 id="thumbnail-hero-title">Smaller images, processed inside the database</h2>
                  <p>This page shows thumbnails generated from uploaded photos using Photon, an image-processing library running as WebAssembly inside Oracle Database through MLE.</p>
                  <p>Each thumbnail is resized to 10% of the original image’s width and height and stored as a PNG. The cards show the original and thumbnail dimensions and file sizes, so you can compare the results. Select a card to view the photo’s details.</p>
                  <p class="thumbnail-hero__note"><strong>Note:</strong> A smaller image does not always mean a smaller file. The result depends on the original format, its compression, and the image content.</p>
                </section>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    region thumbnail-status (
        name: Thumbnail status
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                    l_missing number;
                begin
                    select count(*) into l_missing
                      from mle_data
                     where file_blob is not null and thumbnail is null;

                    if l_missing > 0 then
                        sys.htp.p('<p>Photos without a completed thumbnail: ' || l_missing || '. New uploads are processed in the background. Processing may still be running or may have failed; check the background process if a thumbnail remains unavailable.</p>');
                    end if;
                end;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region thumbnails (
        name: Timeline
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.id,
                       p.created_by as user_name,
                       p.post_comment as comment_text,
                       p.thumbnail,
                       'image/png' as thumbnail_mime,
                       case when instr(p.image_dimension, '|') > 0
                            then rtrim(substr(p.image_dimension, 1, instr(p.image_dimension, '|') - 1))
                            else p.image_dimension
                       end as original_info,
                       case when instr(p.image_dimension, '|') > 0
                            then ltrim(substr(p.image_dimension, instr(p.image_dimension, '|') + 1))
                       end as thumbnail_info,
                       apex_util.get_since(p.created) as post_date
                  from mle_data p
                 order by p.created desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
            cssClasses: t-Chat
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            column: USER_NAME
        }
        subtitle {
            column: POST_DATE
        }
        body {
            advancedFormatting: true
            htmlExpression: <span class="u-text-body-lg">&ORIGINAL_INFO!HTML.<br><span class="thumbnail-info">&THUMBNAIL_INFO!HTML.</span></span>
        }
        iconAndBadge {
            iconSource: initials
            iconColumn: USER_NAME
        }
        media {
            source: blobColumn
            blobColumn: THUMBNAIL
            position: first
            appearance: widescreen
            sizing: cover
            cssClasses: selectDisable
            imageDescription: &COMMENT_TEXT.
        }
        blobAttributes {
            mimeTypeColumn: THUMBNAIL_MIME
        }
        performance {
            lazyLoading: true
        }

        action details (
            type: fullCard
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 2
                    items: {
                        P2_ID: &ID.
                    }
                }
            }
        )

    )

)

