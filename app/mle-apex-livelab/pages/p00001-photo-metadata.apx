page 1 (
    name: Photo Metadata
    alias: PHOTO-METADATA
    title: Photo Metadata
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            apex.actions.add([{
                name: "delete",
                action: (event, element, args) => {
                    apex.items.P1_ACTION_ID.value = args.id;
                    apex.event.trigger(document, 'action-delete');
                }
            }, {
                name: "open-map",
                action: () => {
                    apex.event.trigger(document, 'action-open-map');
                }
            }, {
                name: "open-about",
                action: () => {
                    apex.event.trigger(document, 'action-open-about');
                }
            }]);
            
            window.setTimeout(() => {
                const timeline = apex.region("timeline");
            
                if (timeline && timeline.refresh) {
                    timeline.refresh();
                }
            }, 5000);
            ```
    }
    css {
        inline:
            ```css
            /* Ordnet Suchfeld und "Add Post"-Button in der Timeline-Toolbar an. */
            #timeline-toolbar {
                --timeline-control-height: 4.45rem;
                margin: 1rem 1rem 2.75rem;
            }
            
            #timeline-toolbar .t-ButtonRegion-wrap,
            #timeline-toolbar .t-Region-body {
                align-items: stretch;
                display: flex;
                gap: 1.5rem;
                flex-wrap: wrap;
                justify-content: flex-start;
            }
            
            #timeline-toolbar .t-ButtonRegion-col,
            #timeline-toolbar .t-ButtonRegion-buttons {
                display: flex;
            }
            
            #timeline-toolbar .t-ButtonRegion-col--right {
                order: 1;
            }
            
            #timeline-toolbar .t-ButtonRegion-col--content {
                flex: 1 1 28rem;
                order: 2;
            }
            
            #timeline-toolbar .t-ButtonRegion-body {
                inline-size: 100%;
            }
            
            #timeline-toolbar .t-Form-fieldContainer {
                inline-size: 100%;
                margin-block: 0;
                min-inline-size: min(48rem, 100%);
            }
            
            /* Macht das Suchfeld optisch gleich hoch wie den Button daneben. */
            #timeline-toolbar .t-Form-inputContainer,
            #timeline-toolbar .apex-item-text {
                block-size: var(--timeline-control-height);
            }
            
            #timeline-toolbar .apex-item-text {
                font-size: 1.125rem;
                padding-block: 1rem;
            }
            
            /* Gestaltet den "Add Post"-Button als prominente Aktion. */
            #timeline-toolbar .new-post-button {
                --a-button-font-size: 1.15rem;
                --a-button-padding-y: 0;
                --a-button-padding-x: 1.45rem;
                align-items: center;
                background: linear-gradient(135deg, #2d2c29 0%, #242320 52%, #1f1e1c 100%);
                block-size: var(--timeline-control-height);
                border: 1px solid rgba(255, 255, 255, .12);
                border-radius: 8px;
                box-shadow: 0 .65rem 1.35rem rgba(31, 30, 28, .22), inset 0 1px 0 rgba(255, 255, 255, .14);
                color: #ffffff;
                display: inline-flex;
                font-weight: 700;
                justify-content: center;
                letter-spacing: 0;
                min-inline-size: 12.5rem;
                overflow: hidden;
                position: relative;
                transition: box-shadow .15s ease, filter .15s ease, transform .15s ease;
            }
            
            #timeline-toolbar .new-post-button::after {
                content: none;
            }
            
            /* Vergrößert das Finger-Icon im Button und legt es in einen Kreis. */
            #timeline-toolbar .new-post-button .t-Icon,
            #timeline-toolbar .new-post-button .fa {
                align-items: center;
                background: rgba(255, 255, 255, .12);
                border: 1px solid rgba(255, 255, 255, .22);
                border-radius: 999px;
                box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .18);
                color: #ffffff;
                display: inline-flex;
                font-size: 2.2rem;
                inline-size: 2.8rem;
                justify-content: center;
                margin-inline-end: 1rem;
                position: relative;
                z-index: 1;
            }
            
            #timeline-toolbar .new-post-button .t-Button-label {
                margin-inline-start: .35rem;
                position: relative;
                z-index: 1;
            }
            
            /* Blendet ein zusätzliches Icon rechts vom Buttontext aus. */
            #timeline-toolbar .new-post-button .t-Button-label ~ .t-Icon,
            #timeline-toolbar .new-post-button .t-Button-label ~ .fa {
                display: none;
            }
            
            #timeline-toolbar .new-post-button:hover {
                box-shadow: 0 .85rem 1.65rem rgba(31, 30, 28, .30), inset 0 1px 0 rgba(255, 255, 255, .18);
                filter: brightness(1.08);
                transform: translateY(-1px);
            }
            
            #timeline-toolbar .new-post-button:active {
                box-shadow: 0 .35rem .8rem rgba(31, 30, 28, .22), inset 0 1px 0 rgba(255, 255, 255, .10);
                transform: translateY(0);
            }
            
            /* Hält den "Add Post"-Button auf kleinen Screens unten rechts erreichbar. */
            @media (max-width: 640px) {
                .new-post-button {
                    position: fixed;
                    bottom: 24px;
                    right: 24px;
                    z-index: 1000;
                }
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region about (
        name: About
        type: staticContent
        source {
            htmlCode:
                ```html
                This application demonstrates many out-of-the-box features of APEX while also showing how an APEX developer can enhance and extend functionality with some custom HTML, mininmal CSS and some Javascript. Further, this application should behave beautifully on either Desktop or Mobile devices!
                <h3>App Development concepts</h3>
                <ul>
                <li>Single Page Application</li>
                <li>Progressive Web App</li>
                <li>Mobile Friendly - can use device location and camera</li>
                <li>File upload</li>
                <li>Activity locations map</li>
                </ul>
                <h3>Database & APEX concepts</h3>
                <ul>
                <li>Page Designer</li>
                <li>QuickSQL and relational datamodel</li>
                <li>Form Region</li>
                <li>Cards Region</li>
                <li>Dialogs</li>
                <li>Working with BLOBs</li>
                <li>Javascript</li>
                <li>Dynamic Actions</li>
                <li>Custom Events</li>
                <li>Custom HTML and CSS styling</li>
                </ul>
                ```
        }
        layout {
            sequence: 40
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-drawer
            templateOptions: [
                #DEFAULT#
                js-dialog-class-t-Drawer--pullOutEnd
            ]
        }
        advanced {
            htmlDomId: about
            regionDisplaySelector: true
        }
    )

    region post (
        name: Post
        type: form
        source {
            location: localDatabase
            tableName: MLE_DATA
        }
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-nosize
                js-headingLevel-1
            ]
        }
        edit {
            enabled: true
            allowedOperations: add
        }
    )

    region post-locations (
        name: Post Locations
        type: map
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lat, lon, created_by as who, apex_util.get_since(created) since
                from MLE_DATA
                where lat is not null
                  and lon is not null
                ```
        }
        layout {
            sequence: 20
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: map
        }
        map {
            height: 300
        }
        controls {
            options: [
                mousewheelZoom
                rectangleZoom
                scaleBar
                infiniteMap
                getBrowserLocation
            ]
        }
        initialPositionAndZoom {
            getPositionFromBrowser: true
        }
        attributes {
            messagesPosition: below
        }

        layer locations (
            name: Locations
            layout {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LON
                latitudeColumn: LAT
            }
            tooltip {
                advancedFormatting: true
                htmlExpression: &WHO. @ &SINCE.
            }
            legend {
                show: false
            }
        )

    )

    region timeline (
        name: Timeline
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                p.id,
                p.created_by AS user_name,
                p.post_comment AS comment_text,
                p.file_blob,
                p.file_mime,
                apex_util.get_since(p.created) post_date
                from MLE_DATA p
                order by p.created desc;
                
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
            cssClasses: t-Chat
        }
        advanced {
            htmlDomId: timeline
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            column: USER_NAME
        }
        subtitle {
            column: POST_DATE
        }
        body {
            column: COMMENT_TEXT
        }
        iconAndBadge {
            iconSource: initials
            iconColumn: USER_NAME
        }
        media {
            source: blobColumn
            blobColumn: FILE_BLOB
            position: first
            appearance: widescreen
            sizing: cover
            cssClasses: selectDisable
            imageDescription: &COMMENT_TEXT.
        }
        blobAttributes {
            mimeTypeColumn: FILE_MIME
        }
        performance {
            lazyLoading: true
        }

        action action-2 (
            label: Delete
            layout {
                position: secondary
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: #action$delete?id=&ID.
            }
            appearance {
                displayType: icon
                icon: fa-trash-o
            }
            serverSideCondition {
                type: expression
                plsqlExpression: trim(:user_name)=trim(:APP_USER)
            }
        )

        action action-3 (
            type: fullCard
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 2
                    items: {
                        P2_ID: &ID.
                    }
                }
            }
        )

    )

