        }
        behavior {
            action: triggerAction
        }

        triggerAction native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @post
            }
            execution {
                sequence: 10
            }
        )

    )

    button save (
        buttonName: SAVE
        label: Post
