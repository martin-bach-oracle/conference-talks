    process create-thumbnail (
        name: Create thumbnail with Photon
        type: executeCode
        executionChain: @thumbnail-background
        source {
            language: javaScript-mle
            javaScriptCode:
                ```javascript-mle
                const { createThumbnail } = await import('photon-module');
                
                const rawId = apex.env.P1_ID;
                const id = Number(rawId);
                
                if (rawId == null || String(rawId).trim() === '' ||
                    !Number.isSafeInteger(id) || id <= 0) {
                    throw new Error('P1_ID must contain a valid numeric photo ID');
                }
                
                createThumbnail(id);
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9988619923269524
        }
    )

    process extract-validate-and-store-exif-data (
        name: Extract validate and store EXIF data
        type: executeCode
        source {
            language: javaScript-mle
            javaScriptCode:
                ```javascript-mle
                // Load the EXIF library from the MLE environment.
                const { default: exifr } = await import('exifr-module');
                
                // get the post ID from the APEX page
                const postId = apex.env.P1_ID;
                
                // Fetch the uploaded image as a byte stream, so exifr can read it.
                const photo = apex.conn.execute(
                    `
                    select file_blob
                    from mle_data
                    where id = :id
                    `,
                    {
                        id: { val: postId }
                    },
                    {
                        fetchInfo: {
                            FILE_BLOB: {
                                type: oracledb.UINT8ARRAY
                            }
                        }
                    });
                
                if (photo.rows.length !== 1) {
                    throw new Error('no photo found on this page');
                }
                
                // Parse EXIF metadata with the JavaScript library.
                const exifData = await exifr.parse(photo.rows[0].FILE_BLOB.buffer);
                
                if (!exifData) {
                    return;
                }
                
                // Store the EXIF JSON and GPS coordinates back in the database.
                const updateResult = apex.conn.execute(
                    `
                    update mle_data
                    set exif_data = :data,
                        lon = :lon,
                        lat = :lat
                    where id = :id
                    `,
                    {
                        data: {
                            type: oracledb.DB_TYPE_JSON,
                            val: exifData
                        },
                        lon: {
                            type: oracledb.NUMBER,
                            val: exifData.longitude === undefined ? null : exifData.longitude
                        },
                        lat: {
                            type: oracledb.NUMBER,
                            val: exifData.latitude === undefined ? null : exifData.latitude
                        },
                        id: { val: postId }
                    }
                );
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: EXIF Data successfully stored in the database
        }
        error {
            errorMessage: Something went wrong extracting/storing the EXIF information
        }
        advanced {
            executionMappingIdentifier: 16427949220127701
        }
    )

    process prepare-ela (
        name: Prepare ELA for JPEG
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                insert into mle_data_ela (mle_data_id, status)
                select id, 'PENDING'
                  from mle_data
                 where id = :P1_ID
                   and lower(file_mime) in ('image/jpeg', 'image/jpg')
                   and file_blob is not null
                   and not exists (select 1 from mle_data_ela e where e.mle_data_id = mle_data.id);
                ```
        }
        execution {
            sequence: 25
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process create-ela (
        name: Generate ELA image
        type: executeCode
        executionChain: @ela-background
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_original blob;
                    l_result blob;
                    l_error varchar2(1000);
                begin
                    begin
                        select p.file_blob into l_original
                          from mle_data p join mle_data_ela e on e.mle_data_id = p.id
                         where p.id = :P1_ID and e.status = 'PENDING';
                    exception
                        when no_data_found then return;
                    end;

                    l_result := photo_ela(l_original);
                    if l_result is null then
                        raise_application_error(-20001, 'ELA did not produce an image');
                    end if;
                    update mle_data_ela
                       set ela_image = l_result,
                           metadata = json_object('jpeg_quality' value 90, 'amplification' value 10,
                                                  'output_mime' value 'image/jpeg', 'output_jpeg_quality' value 95),
                           status = 'READY', error_message = null
                     where mle_data_id = :P1_ID and status = 'PENDING';
                    if dbms_lob.istemporary(l_result) = 1 then
                        dbms_lob.freetemporary(l_result);
                    end if;
                exception
                    when others then
                        l_error := substr(sqlerrm, 1, 1000);
                        if l_result is not null and dbms_lob.istemporary(l_result) = 1 then
                            dbms_lob.freetemporary(l_result);
                        end if;
                        update mle_data_ela set status = 'FAILED', error_message = l_error
                         where mle_data_id = :P1_ID and status = 'PENDING';
                end;
                ```
        }
        execution {
            sequence: 20
        }
    )

