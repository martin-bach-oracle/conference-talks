page 1 (
    name: Photo Metadata
    alias: PHOTO-METADATA
    title: Photo Metadata
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            apex.actions.add([{
                name: "delete",
                action: (event, element, args) => {
                    apex.items.P1_ACTION_ID.value = args.id;
                    apex.event.trigger(document, 'action-delete');
                }
            }, {
                name: "open-map",
                action: () => {
                    apex.event.trigger(document, 'action-open-map');
                }
            }, {
                name: "open-about",
                action: () => {
                    apex.event.trigger(document, 'action-open-about');
                }
            }]);
            
            window.setTimeout(() => {
                const timeline = apex.region("timeline");
            
                if (timeline && timeline.refresh) {
                    timeline.refresh();
                }
            }, 5000);
            ```
    }
    css {
        inline:
            ```css
            .photo-hero {
                padding: clamp(1rem, 3vw, 2.5rem);
                color: #fff;
            }
            .photo-hero__eyebrow {
                color: #b8d9d8;
                font-size: .8rem;
                font-weight: 700;
                letter-spacing: .12em;
                text-transform: uppercase;
            }
            .photo-hero h2 {
                color: #fff;
                font-size: clamp(1.75rem, 3.6vw, 2.75rem);
                line-height: 1.15;
                margin: .75rem 0 1rem;
            }
            .photo-hero p {
                color: #fff;
                font-size: 1rem;
                line-height: 1.6;
                max-width: 70rem;
                margin-bottom: 0;
            }

            #photo-intro {
                --timeline-control-height: 4.45rem;
                background: var(--slide-surface);
                border: 1px solid var(--slide-border);
                border-radius: 16px;
            }
            #photo-intro .t-ButtonRegion-wrap {
                align-items: center;
                display: flex;
                flex-wrap: wrap;
                gap: 1rem;
            }
            #photo-intro .t-ButtonRegion-col--content {
                flex: 1 1 30rem;
                min-width: 0;
            }
            #photo-intro .t-ButtonRegion-col--right {
                padding: 1rem clamp(1rem, 3vw, 2.5rem);
            }

            /* Gestaltet den "Add Post"-Button als prominente Aktion. */
            #photo-intro .new-post-button {
                --a-button-font-size: 1.15rem;
                --a-button-padding-y: 0;
                --a-button-padding-x: 1.45rem;
                align-items: center;
                background: var(--slide-coral);
                block-size: var(--timeline-control-height);
                border: 1px solid var(--slide-coral);
                border-radius: 8px;
                box-shadow: none;
                color: #102e33;
                display: inline-flex;
                font-weight: 700;
                justify-content: center;
                letter-spacing: 0;
                min-inline-size: 12.5rem;
                overflow: hidden;
                position: relative;
                transition: box-shadow .15s ease, filter .15s ease, transform .15s ease;
            }
            
            #photo-intro .new-post-button::after {
                content: none;
            }
            
            /* Vergrößert das Finger-Icon im Button und legt es in einen Kreis. */
            #photo-intro .new-post-button .t-Icon,
            #photo-intro .new-post-button .fa {
                align-items: center;
                background: rgba(255, 255, 255, .25);
                border: 1px solid rgba(0, 49, 62, .2);
                border-radius: 999px;
                box-shadow: none;
                color: #102e33;
                display: inline-flex;
                font-size: 2.2rem;
                inline-size: 2.8rem;
                justify-content: center;
                margin-inline-end: 1rem;
                position: relative;
                z-index: 1;
            }
            
            #photo-intro .new-post-button .t-Button-label {
                margin-inline-start: .35rem;
                position: relative;
                z-index: 1;
            }
            
            /* Blendet ein zusätzliches Icon rechts vom Buttontext aus. */
            #photo-intro .new-post-button .t-Button-label ~ .t-Icon,
            #photo-intro .new-post-button .t-Button-label ~ .fa {
                display: none;
            }
            
            #photo-intro .new-post-button:hover {
                box-shadow: 0 .85rem 1.65rem rgba(31, 30, 28, .30), inset 0 1px 0 rgba(255, 255, 255, .18);
                filter: brightness(1.08);
                transform: translateY(-1px);
            }
            
            #photo-intro .new-post-button:active {
                box-shadow: 0 .35rem .8rem rgba(31, 30, 28, .22), inset 0 1px 0 rgba(255, 255, 255, .10);
                transform: translateY(0);
            }
            
            ```
