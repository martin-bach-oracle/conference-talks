    region timeline (
        name: Timeline
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                p.id,
                p.created_by AS user_name,
                p.post_comment AS comment_text,
                nvl(p.thumbnail, p.file_blob) file_blob,
                p.file_mime,
                apex_util.get_since(p.created) post_date
                from MLE_DATA p
                order by p.created desc;
                
                ```
        }
        layout {
