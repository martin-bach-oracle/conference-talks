        }
        behavior {
            action: triggerAction
            executeValidations: false
            databaseAction: insert
        }

        triggerAction native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SAVE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction action-delete (
        name: action-delete
        execution {
            sequence: 90
        }
        when {
            event: custom
            customEvent: action-delete
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action delete-confirm-dialog (
            name: DELETE Confirm dialog
            action: confirm
            settings {
                title: Are you sure?
                message: You are about to delete this post. Are you sure?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action delete-do-database-work (
            name: DELETE - do database work
            action: executeServerSideCode
            settings {
                plsqlCode: delete from MLE_DATA where id=:P1_ACTION_ID and created_by=:APP_USER;
                itemsToSubmit: P1_ACTION_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action delete-remove-post-in-ui (
            name: DELETE - remove post in UI
            action: executeJsCode
            settings {
                jsCode: "$('[data-id='+apex.items.P1_ACTION_ID.value+']').remove();"
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

